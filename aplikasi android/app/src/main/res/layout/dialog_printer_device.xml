<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Perangkat Printer"
            android:textColor="@color/mataverse_text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Konfigurasikan alias ID yang akan dipanggil oleh website Lakasir."
            android:textColor="@color/mataverse_text_muted"
            android:textSize="12sp" />

        <!-- Alias ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDeviceAlias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Alias / Target ID (contoh: kasir, dapur, bar)"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Device Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nama Tampilan (contoh: Printer Dapur)"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Connection Mode Radio -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Tipe Koneksi Hardware"
            android:textColor="@color/mataverse_text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/dialogModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/dialogModeBluetooth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Bluetooth" />

            <RadioButton
                android:id="@+id/dialogModeTcp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TCP / LAN" />
        </RadioGroup>

        <!-- Bluetooth Config Section -->
        <LinearLayout
            android:id="@+id/dialogBtSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBtnSelectBt"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Printer Bluetooth Paired"
                android:textSize="13sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_printer" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDeviceBtMac"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bluetooth MAC Address"
                    android:inputType="textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- TCP / LAN Config Section -->
        <LinearLayout
            android:id="@+id/dialogTcpSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDeviceTcpHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="IP Address Printer (contoh: 192.168.1.200)"
                    android:inputType="textNoSuggestions" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputDeviceTcpPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Port (default: 9100)"
                    android:inputType="number"
                    android:text="9100" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Paper Width -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ukuran Kertas Thermal"
            android:textColor="@color/mataverse_text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/dialogPaperGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/dialogPaper58"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="58mm (32 Kolom)" />

            <RadioButton
                android:id="@+id/dialogPaper80"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="80mm (48 Kolom)" />
        </RadioGroup>

        <!-- Default Switch -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchIsDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Jadikan Printer Default" />

    </LinearLayout>
</ScrollView>

